{
  "name": "grupomar/operaciones-maritimas",
  "description": "Plataforma empresarial de descarga, pesaje, recepción, inventario y trazabilidad de Grupo Mar.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "codeigniter4/framework": "^4.7",
    "codeigniter4/shield": "^1.4",
    "dompdf/dompdf": "^3.1",
    "endroid/qr-code": "^5.0",
    "picqer/php-barcode-generator": "^3.2",
    "ramsey/uuid": "^4.7"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "mikey179/vfsstream": "^1.6",
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Support\\": "tests/_support"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs --standard=PSR12 app tests"
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

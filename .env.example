CI_ENVIRONMENT = development

app.baseURL = 'http://descarga.local/'
app.forceGlobalSecureRequests = false
session.expiration = 7200
cookie.secure = false

database.default.hostname = 127.0.0.1
database.default.database = grupomar_operaciones
database.default.username = grupomar_app
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_0900_ai_ci

encryption.key =

auth.allowRegistration = false
auth.recordActiveDate = true
auth.minimumPasswordLength = 12

operational.defaultCompanyId = 1
operational.defaultSiteId = 1
operational.defaultTimezone = America/Mexico_City
operational.estimatedTareKg = 176.000
operational.lotRuleVersion = 1

integrations.scale.driver = simulator
integrations.scale.allowSimulatorInProduction = false
integrations.scale.middlewareUrl = 'http://127.0.0.1:8787'
integrations.scale.apiKey =
integrations.scale.simulatorWeightKg = 986.500
integrations.printer.driver = pdf
integrations.printer.templateCode = TINA_RECEPCION
integrations.printer.middlewareUrl = 'http://127.0.0.1:8788'
integrations.printer.apiKey =

api.clientId = environment
api.keyHash =
api.permissions = health.read
api.companyId = 1
api.siteId = 1
api.rateLimitPerMinute = 120
api.ipRateLimitPerMinute = 600

email.fromEmail = 'no-reply@descarga.local'
email.fromName = 'Grupo Mar Operaciones'
email.protocol = smtp
email.SMTPHost =
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls
